<?xml version="1.0"?>
<yandex>
    <!-- ClickHouse Configuration for Development -->
    <!-- This configuration file is used for local development -->
    <!-- Place this file at: ~/.clickhouse-local/config.xml -->

    <!-- Data directories -->
    <!-- Note: In production, replace these paths with your preferred data directory -->
    <path>/Users/agautam/.clickhouse-local/data/</path>
    <tmp_path>/Users/agautam/.clickhouse-local/tmp/</tmp_path>
    <user_files_path>/Users/agautam/.clickhouse-local/user_files/</user_files_path>
    <access_control_path>/Users/agautam/.clickhouse-local/access/</access_control_path>

    <!-- Server configuration -->
    <listen_host>127.0.0.1</listen_host>
    <listen_host>::1</listen_host>

    <!-- Ports -->
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <!-- Logging -->
    <logger>
        <level>information</level>
        <log>/Users/agautam/.clickhouse-local/logs/clickhouse-server.log</log>
        <errorlog>/Users/agautam/.clickhouse-local/logs/clickhouse-server.err.log</errorlog>
        <size>10M</size>
        <count>5</count>
    </logger>

    <!-- Default database and settings -->
    <default_database>default</default_database>

    <!-- Default compression codec -->
    <compression>
        <case>
            <min_part_size>10485760</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>lz4</method>
        </case>
    </compression>

    <!-- Query limits -->
    <max_concurrent_queries>100</max_concurrent_queries>
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>

    <!-- Profile settings -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <!-- Users -->
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
        <readonly>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </readonly>
    </users>

    <!-- Quotas -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Timezone -->
    <timezone>UTC</timezone>

</yandex>
